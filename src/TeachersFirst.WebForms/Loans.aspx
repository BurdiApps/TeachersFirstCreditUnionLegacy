<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="Loans.aspx.cs" Inherits="TeachersFirst.WebForms.LoansPage" MasterPageFile="~/Site.Master" %>
<asp:Content ID="Title" ContentPlaceHolderID="HeadContent" runat="server"><title>Loans &amp; Rates | Teachers First Credit Union</title></asp:Content>
<asp:Content ID="Body" ContentPlaceHolderID="MainContent" runat="server">
  <section class="page-intro"><p class="kicker">LOANS &amp; CREDIT</p><h1>Plan for the next big thing.</h1><p>These imaginary product examples and rates are here to make the practice site feel complete.</p></section>
  <section class="rates-page" id="rates"><article id="auto-loan"><p class="kicker">SAMPLE PRODUCT</p><h2>Auto Loans</h2><p>Illustrative starting rate</p><strong>5.49% <small>APR*</small></strong><p>Consider purchase price, term, insurance, and total cost before borrowing.</p></article><article id="certificate"><p class="kicker">SAMPLE PRODUCT</p><h2>12-Month Certificate</h2><p>Illustrative dividend yield</p><strong>4.00% <small>APY*</small></strong><p>Rates, terms, and withdrawal rules are fictional examples only.</p></article><article id="home-loan"><p class="kicker">SAMPLE PRODUCT</p><h2>Home Equity</h2><p>Illustrative starting rate</p><strong>6.75% <small>APR*</small></strong><p>Home-secured borrowing involves risks and is not offered by this demo.</p></article></section>
  <section class="calculator" id="calculator"><div><p class="kicker">INTERACTIVE WEB FORMS EXERCISE</p><h2>Estimate a monthly payment</h2><p>Fixed-rate principal-and-interest estimate only. Taxes, fees, and lender terms are excluded.</p></div><div class="calculator-fields">
    <div><asp:Label runat="server" AssociatedControlID="LoanAmount" Text="Loan amount ($)" /><asp:TextBox ID="LoanAmount" runat="server" Text="25000" MaxLength="12" /><asp:RequiredFieldValidator runat="server" ControlToValidate="LoanAmount" ValidationGroup="PaymentCalc" ErrorMessage="Enter an amount." Display="Dynamic" CssClass="error" EnableClientScript="false" /><asp:RangeValidator runat="server" ControlToValidate="LoanAmount" ValidationGroup="PaymentCalc" MinimumValue="1" MaximumValue="1000000" Type="Double" ErrorMessage="Enter an amount from $1 to $1,000,000." Display="Dynamic" CssClass="error" EnableClientScript="false" /></div>
    <div><asp:Label runat="server" AssociatedControlID="AnnualRate" Text="Annual rate (%)" /><asp:TextBox ID="AnnualRate" runat="server" Text="5.49" MaxLength="6" /><asp:RequiredFieldValidator runat="server" ControlToValidate="AnnualRate" ValidationGroup="PaymentCalc" ErrorMessage="Enter an annual rate." Display="Dynamic" CssClass="error" EnableClientScript="false" /><asp:RangeValidator runat="server" ControlToValidate="AnnualRate" ValidationGroup="PaymentCalc" MinimumValue="0" MaximumValue="50" Type="Double" ErrorMessage="Enter a rate from 0 to 50%." Display="Dynamic" CssClass="error" EnableClientScript="false" /></div>
    <div><asp:Label runat="server" AssociatedControlID="TermMonths" Text="Term (months)" /><asp:TextBox ID="TermMonths" runat="server" Text="60" MaxLength="3" /><asp:RequiredFieldValidator runat="server" ControlToValidate="TermMonths" ValidationGroup="PaymentCalc" ErrorMessage="Enter a term." Display="Dynamic" CssClass="error" EnableClientScript="false" /><asp:RangeValidator runat="server" ControlToValidate="TermMonths" ValidationGroup="PaymentCalc" MinimumValue="1" MaximumValue="360" Type="Integer" ErrorMessage="Enter a term from 1 to 360 months." Display="Dynamic" CssClass="error" EnableClientScript="false" /></div>
    <asp:Button runat="server" Text="Calculate Estimate" OnClick="CalculatePayment_Click" CssClass="button" ValidationGroup="PaymentCalc" />
  </div><asp:Label ID="LoanPaymentResult" runat="server" CssClass="calculation-result" role="status" /></section><p class="disclaimer">*Illustrative rates are not offers or financial advice. This demo does not accept applications or process payments.</p>
</asp:Content>