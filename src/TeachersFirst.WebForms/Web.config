<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <authentication mode="Forms">
      <forms name="TeachersFirstDemo" loginUrl="~/Default.aspx" timeout="20" slidingExpiration="false" cookieless="UseCookies" cookieSameSite="Lax" />
    </authentication>
    <httpCookies httpOnlyCookies="true" sameSite="Lax" />
    <sessionState cookieless="UseCookies" cookieSameSite="Lax" />
    <pages validateRequest="true" enableViewStateMac="true" viewStateEncryptionMode="Always" />
    <customErrors mode="RemoteOnly" />
  </system.web>
  <system.webServer>
    <defaultDocument>
      <files><clear /><add value="Default.aspx" /></files>
    </defaultDocument>
    <httpProtocol>
      <customHeaders><add name="X-Content-Type-Options" value="nosniff" /><add name="X-Frame-Options" value="DENY" /></customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>